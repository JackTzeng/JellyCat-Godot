[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/debug/debug_panel.gd" id="1_debug"]

[node name="DebugPanel" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
script = ExtResource("1_debug")

[node name="Main" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Main"]
